[Desktop Entry]
Type=Service
X-KDE-ServiceTypes=KonqPopupMenu/Plugin
MimeType=all/allfiles;
X-KDE-Protocols=file
X-KDE-Submenu=Shred
X-KDE-Priority=TopLevel
Icon=edit-delete-shred
Actions=shredOverwrite;

[Desktop Action shredOverwrite]
Name=Overwrite only (keep file)…
Icon=document-edit
Exec=@SHRED_GUI_EXECUTABLE@ --preset shred-overwrite %U
