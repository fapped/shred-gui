[Desktop Entry]
Type=Service
X-KDE-ServiceTypes=KonqPopupMenu/Plugin
MimeType=all/allfiles;inode/directory;
X-KDE-Protocols=file
X-KDE-Submenu=Shred
X-KDE-Priority=TopLevel
Icon=edit-delete-shred
Actions=shredDelete;

[Desktop Action shredDelete]
Name=Shred and delete permanently (-n 3 -z -u)…
Icon=edit-delete-shred
Exec=@SHRED_GUI_EXECUTABLE@ --preset shred-delete %U
